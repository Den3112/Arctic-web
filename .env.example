# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service Role Key is required for admin scripts but NOT for the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-only-for-scripts

# Site URL (Recommended for Production)
NEXT_PUBLIC_SITE_URL=https://arctic-web-solutions.vercel.app/
