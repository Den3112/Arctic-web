# ============================================
# ArcticTime — Environment Variables
# ============================================
# Copy this file: cp .env.example .env.local
# Then fill in your Supabase credentials below.

# --- REQUIRED ---
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- OPTIONAL ---
# Service Role Key (only needed for admin scripts, NOT used by the app)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (defaults to localhost for development)
# Change to your production URL when deploying (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
